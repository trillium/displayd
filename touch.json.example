{
  "_comment": "Example touch.py config for lnx-server. Copy to touch.json on the host and edit: confirm device with `python3 touch.py --list-devices`, raw range with evtest, and width/height with fbset. Env overrides: DISPLAYD_TOUCH_DEVICE, DISPLAYD_URL, DISPLAYD_TOUCH_WIDTH/HEIGHT, DISPLAYD_TOUCH_CONFIDENCE (1 to enable confidence-mode tap feedback). Keep confidence_feedback disabled except during tap tests; see TOUCH.md. Sleep/wake: the global screen-off badge sleeps the panel via the existing screen_off action; the scoped sleep wake region wakes it via screen_on (daemon restores the pre-sleep view). Revert: restore the backup (see TOUCH.md).",
  "device": "/dev/input/event8",
  "endpoint": "http://127.0.0.1:8980",
  "width": 1920,
  "height": 1080,
  "calibration": {
    "x_min": 0,
    "x_max": 1920,
    "y_min": 0,
    "y_max": 1080,
    "swap_xy": false,
    "invert_x": false,
    "invert_y": false,
    "rotation": 0
  },
  "tap_max_seconds": 0.5,
  "tap_max_pixels": 40,
  "debounce_seconds": 0.3,
  "confidence_feedback": {
    "enabled": false,
    "renderer": "touch_confidence",
    "input": "tap"
  },
  "tap_options": {
    "enabled": true,
    "renderer": "options",
    "params": {}
  },
  "regions": [
    {
      "id": "screen-off",
      "_comment": "sleep badge (top-right moon, renderers/sleep_chrome.py): fires the existing screen_off action. Listed before the full-height strips so it wins its square (hit_test takes the first match). Powering off also switches to the sleep view, whose scoped wake region shadows every strip while asleep.",
      "rect": [1760, 0, 160, 160],
      "action": {"name": "screen_off"}
    },
    {
      "id": "playlist-next",
      "rect": [1280, 0, 640, 1080],
      "action": {"name": "playlist_next"}
    },
    {
      "id": "screen-on",
      "rect": [0, 0, 640, 1080],
      "action": {"name": "screen_on"}
    },
    {
      "id": "tap-to-rate",
      "rect": [640, 840, 640, 240],
      "action": {"name": "feedback", "view": "clock", "rating": 5}
    },
    {
      "id": "reload-confirm",
      "_comment": "tap anywhere while the RELOADED view shows to confirm it (view-gated: no-op otherwise); last so narrower regions win their own taps first (hit_test takes the first match)",
      "rect": [0, 0, 1920, 1080],
      "action": {"name": "reload_confirm"}
    }
  ],
  "view_regions": {
    "sleep": [
      {
        "id": "wake",
        "_comment": "fullscreen wake target, live ONLY while the sleep view shows (the daemon switches there on every power-off). Scoped regions are hit-tested before global ones, so while asleep this shadows every strip and any tap wakes via the existing screen_on action (which also restores the pre-sleep view). While awake it is not live at all.",
        "rect": [0, 0, 1920, 1080],
        "action": {"name": "screen_on"}
      }
    ],
    "picker": [
      {
        "id": "example-view-tile",
        "_comment": "illustrative single select_view tile, live ONLY while the picker shows (the full grid lives in touch-picker.json.example with generated rects -- never hand-compute tile coordinates)",
        "rect": [640, 0, 640, 540],
        "action": {"name": "select_view", "view": "clock"}
      }
    ],
    "unified": [
      {
        "id": "example-uview-tile",
        "_comment": "illustrative single unified tile, live ONLY while the merged home screen shows (the full 19-tile + dock scope lives in touch-unified.json.example with generated rects -- never hand-compute; tile ids carry a uview- prefix so this scope and the picker scope never share an id)",
        "rect": [175, 55, 513, 82],
        "action": {"name": "select_view", "view": "activity"}
      },
      {
        "id": "example-apps-dock",
        "_comment": "apps dock: one tap opens the merged macbook screen, live ONLY while the merged home screen shows (generated rect -- see touch-unified.json.example)",
        "rect": [80, 770, 1760, 230],
        "action": {"name": "select_view", "view": "macbook"}
      }
    ],
    "macbook": [
      {
        "id": "mac-to-glance",
        "_comment": "back to GLANCE (pins glance params); bottom-left, free of the composited badges: harmless no-op while glance shows, the way back while AIM shows. Rect is macbook_layout.back_rect() -- never hand-edit",
        "rect": [0, 1024, 180, 56],
        "action": {"name": "macbook_mode", "mode": "glance"}
      },
      {
        "id": "mac-tab-prev",
        "_comment": "page the app strip one window back (clamps at the first page). Rect is macbook_layout.stepper_rect('left') -- never hand-edit",
        "rect": [176, 88, 72, 52],
        "action": {"name": "talon_tab", "dir": -1}
      },
      {
        "id": "mac-tab-next",
        "_comment": "page the app strip one window forward (clamps at the last page). Rect is macbook_layout.stepper_rect('right') -- never hand-edit",
        "rect": [1672, 88, 72, 52],
        "action": {"name": "talon_tab", "dir": 1}
      },
      {
        "id": "mac-focus",
        "_comment": "tap a header app chip to focus it (view+mode gated, coordinate-only). Rect is macbook_layout.focus_region() -- never hand-edit, regenerate from there",
        "rect": [176, 88, 1568, 52],
        "action": {"name": "talon_focus"}
      },
      {
        "id": "mac-map",
        "_comment": "tap the display map to warp the MacBook cursor AND enter the fullscreen AIM review in the same gesture (view+mode-gated + fresh-feed-gated on the daemon; header taps refused, never clamped). Coordinates are tap-supplied at dispatch, never stored here. Rect is macbook_layout.map_region() -- never hand-edit; view-specific entries precede global ones, so the map wins its screen space while the strips still serve elsewhere",
        "rect": [0, 148, 1920, 932],
        "action": {"name": "macbook_mouse"}
      },
      {
        "id": "mac-zoom",
        "_comment": "AIM: tap the fullscreen review to click the reviewed point, live ONLY while the merged macbook view shows in AIM mode. Rect is macbook_layout.click_region() (whole panel) and sits LAST so the header controls win their pixels first; daemon-side gates (fresh capture of this point, cursor still on it) refuse anything else, so a tap here can never blind-click",
        "rect": [0, 0, 1920, 1080],
        "action": {"name": "macbook_click"}
      }
    ]
  }
}
