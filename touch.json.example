{
  "_comment": "Example touch.py config for lnx-server. Copy to touch.json on the host and edit: confirm device with `python3 touch.py --list-devices`, raw range with evtest, and width/height with fbset. Env overrides: DISPLAYD_TOUCH_DEVICE, DISPLAYD_URL, DISPLAYD_TOUCH_WIDTH/HEIGHT, DISPLAYD_TOUCH_CONFIDENCE (1 to enable confidence-mode tap feedback). Keep confidence_feedback disabled except during tap tests; see TOUCH.md.",
  "device": "/dev/input/event8",
  "endpoint": "http://127.0.0.1:8980",
  "width": 1920,
  "height": 1080,
  "calibration": {
    "x_min": 0,
    "x_max": 1920,
    "y_min": 0,
    "y_max": 1080,
    "swap_xy": false,
    "invert_x": false,
    "invert_y": false,
    "rotation": 0
  },
  "tap_max_seconds": 0.5,
  "tap_max_pixels": 40,
  "debounce_seconds": 0.3,
  "confidence_feedback": {
    "enabled": false,
    "renderer": "touch_confidence",
    "input": "tap"
  },
  "tap_options": {
    "enabled": true,
    "renderer": "options",
    "params": {}
  },
  "regions": [
    {
      "id": "playlist-next",
      "rect": [1280, 0, 640, 1080],
      "action": {"name": "playlist_next"}
    },
    {
      "id": "screen-on",
      "rect": [0, 0, 640, 1080],
      "action": {"name": "screen_on"}
    },
    {
      "id": "tap-to-rate",
      "rect": [640, 840, 640, 240],
      "action": {"name": "feedback", "view": "clock", "rating": 5}
    },
    {
      "id": "reload-confirm",
      "_comment": "tap anywhere while the RELOADED view shows to confirm it (view-gated: no-op otherwise); last so narrower regions win their own taps first (hit_test takes the first match)",
      "rect": [0, 0, 1920, 1080],
      "action": {"name": "reload_confirm"}
    }
  ],
  "view_regions": {
    "picker": [
      {
        "id": "example-view-tile",
        "_comment": "illustrative single select_view tile, live ONLY while the picker shows (the full grid lives in touch-picker.json.example with generated rects -- never hand-compute tile coordinates)",
        "rect": [640, 0, 640, 540],
        "action": {"name": "select_view", "view": "clock"}
      }
    ],
    "macbook": [
      {
        "id": "mac-map",
        "_comment": "panel tap moves the MacBook cursor, live ONLY while the macbook map view shows (view-gated + fresh-feed-gated on the daemon; header/letterbox taps refused, never clamped). Coordinates are tap-supplied at dispatch, never stored here. Covers the map area between the 250px header and the zoom pane at y=740 (renderers/macbook_zoom.py MAP_BOTTOM); view-specific entries precede global ones, so the map wins its screen space while the strips still serve elsewhere",
        "rect": [0, 250, 1920, 490],
        "action": {"name": "macbook_mouse"}
      },
      {
        "id": "mac-zoom",
        "_comment": "SECOND tap: click the reviewed point on the magnified image, live ONLY while the macbook view shows. The pane (renderers/macbook_zoom.py pane_rect) draws the fresh capture blown up around the cursor, or a position-hint when no fresh capture exists; daemon-side gates (fresh capture of this point, cursor still on it) refuse anything else, so a tap here can never blind-click",
        "rect": [0, 740, 1920, 340],
        "action": {"name": "macbook_click"}
      }
    ],
    "talon_apps": [
      {
        "id": "talon-focus-left",
        "_comment": "tap a LEFT-column app button to focus it, live ONLY while the talon_apps view shows (view-gated: refused otherwise); the tap point picks the button daemon-side via renderers/talon_layout.py. Rect is talon_layout.column_rect('left') -- never hand-edit, regenerate from there",
        "rect": [48, 250, 560, 782],
        "action": {"name": "talon_focus"}
      },
      {
        "id": "talon-focus-right",
        "_comment": "tap a RIGHT-column app button to focus it; same contract as talon-focus-left, rect is talon_layout.column_rect('right')",
        "rect": [1312, 250, 560, 782],
        "action": {"name": "talon_focus"}
      }
    ]
  }
}
