# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Runtime artifacts
*.log
*.pid
/snapshot*.png
/policy.json

# Build output (tools/build_litehtml.sh fetches and builds the pinned
# layout engine here; see docs/HTML_RENDERER.md). The compiled library is
# generated too, so it is never committed -- the build script and the pinned
# revision in it are what make it reproducible.
/build/
renderers/native/liblitehtmlpil.dylib
renderers/native/liblitehtmlpil.so

# Editors / OS
.DS_Store
.idea/
.vscode/

# Agent harness scratch (task transcripts, run receipts). Never part of
# the panel: nothing under here is source, and a scratch .output file can
# run to a thousand lines of somebody else's tool output.
/.pi/
