[Unit]
Description=displayd - API-driven display server
Documentation=file:/opt/displayd/README.md
After=systemd-user-sessions.service

[Service]
Type=simple
User=root
Environment=DISPLAYD_PORT=8980
# Loopback only by default, because the API has no authentication. To serve a
# private network (a VPN or tailnet address) instead, add --bind <address> to
# ExecStart below and firewall the port.
ExecStart=/usr/bin/python3 /opt/displayd/displayd.py
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
