[Unit]
Description=displayd - API-driven display server
Documentation=file:/opt/displayd/README.md
After=systemd-user-sessions.service

[Service]
Type=simple
User=root
Environment=DISPLAYD_PORT=8980
Environment=DISPLAYD_BIND=0.0.0.0
ExecStart=/usr/bin/python3 /opt/displayd/displayd.py
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
